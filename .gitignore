# Binaries and build output
*.test
*.out
coverage.*
apps/server/bin/
apps/desktop/bin/
apps/frontend/dist/
apps/frontend/coverage/
apps/frontend/playwright-report/
apps/frontend/test-results/
apps/desktop/build/bin/

# Dependencies
node_modules/

# TypeScript incremental build state
*.tsbuildinfo

# Runtime data (never commit the library database or artwork cache)
data/
*.db
*.db-shm
*.db-wal

# Local environment and editor files
.env
.env.local
.DS_Store
.idea/
.vscode/

# Generated desktop bindings
apps/frontend/src/desktop/wails/bindings/

# Keep synthetic fixture executables, but ignore real build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
!apps/server/testdata/**/*.exe
