# Path on the Raspberry Pi host where the read-only SMB game share is mounted.
ORYN_GAMES_PATH=/srv/games

# Optional existing file or directory inside the share. If set, Oryn refuses to
# scan when it is missing. This helps distinguish an unavailable mount from an
# empty directory.
# ORYN_LIBRARY_SENTINEL=games

# Scan interval (Go duration). 0 disables scheduled scans.
ORYN_SCAN_INTERVAL=6h

# Host port exposed by the container.
ORYN_PORT=8080

ORYN_LOG_LEVEL=info
