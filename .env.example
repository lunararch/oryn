# Server bind address. Use :8080 inside Docker; keep localhost for local development.
ORYN_HTTP_ADDR=127.0.0.1:8080

# Application data (database, artwork cache, logs, backups). Never inside the game share.
ORYN_DATA_DIR=./data
ORYN_DB_PATH=./data/oryn.db

# Read-only library root containing game folders.
ORYN_LIBRARY_ROOT=/mnt/pinas/games_aapje

# Optional existing path used to verify the library mount is really present.
# ORYN_LIBRARY_SENTINEL=/mnt/pinas/games/.oryn-sentinel

# Optional directory containing the built web application.
# ORYN_WEB_DIR=./apps/frontend/dist

# Scan defaults. Interval 0 disables scheduled scans.
ORYN_SCAN_INTERVAL=0
ORYN_SCAN_MAX_DEPTH=3
ORYN_SCAN_WORKERS=2

# debug, info, warn, error
ORYN_LOG_LEVEL=info
